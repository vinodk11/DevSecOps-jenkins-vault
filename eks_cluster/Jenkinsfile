// Jenkinsfile – Terraform CI/CD for AWS (Final Fixed Version)

pipeline {

    agent {
        docker {
            image 'hashicorp/terraform:1.9.7'
            args '-u root:root'
        }
    }

    parameters {

        choice(
            name: 'TF_ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Select Terraform operation'
        )

        string(
            name: 'WORKSPACE',
            defaultValue: 'default',
            description: 'Terraform workspace name'
        )

        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: true,
            description: 'Skip approval prompt'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
    }

    stages {

        stage('Checkout') {
            steps {
                git url: 'https://github.com/vinodk11/DevSecOps-jenkins-vault.git', branch: 'main'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('eks_cluster') {
                    sh '''
                        terraform workspace select "${WORKSPACE}" \
                        || terraform workspace new "${WORKSPACE}"

                        terraform init -input=false
                    '''
                }
            }
        }

        stage('Terraform Action') {
            steps {
                dir('eks_cluster') {

                    script {

                        def commonArgs = "-input=false -lock=true -no-color"
                        def approveFlag = params.AUTO_APPROVE ? "-auto-approve" : ""

                        if (params.TF_ACTION == 'plan') {

                            sh "terraform plan ${commonArgs}"

                        } else if (params.TF_ACTION == 'apply') {

                            sh "terraform apply ${commonArgs} ${approveFlag}"

                        } else if (params.TF_ACTION == 'destroy') {

                            sh "terraform destroy ${commonArgs} ${approveFlag}"

                        } else {

                            error "Unsupported TF_ACTION: ${params.TF_ACTION}"

                        }
                    }
                }
            }
        }

        stage('Archive State') {

            when {
                expression {
                    params.TF_ACTION == 'apply' || params.TF_ACTION == 'destroy'
                }
            }

            steps {
                archiveArtifacts artifacts: 'eks_cluster/**/*.tfstate', fingerprint: true
            }
        }
    }

    post {

        success {
            echo "✅ Terraform ${params.TF_ACTION} completed successfully."
        }

        failure {
            echo "❌ Terraform ${params.TF_ACTION} failed."
        }
    }
}