        }
    }

    stages {

        stage('Check Java') {
            steps {
                container('maven') {
                    sh 'java --version'
                }
            }
        }

        stage('Check Maven') {
            steps {
                container('maven') {
                    sh 'mvn -version'
                }
            }
        }

        stage('Test') {
            steps {
                container('maven') {
                    sh 'echo "Maven Kubernetes Agent Working"'
                }
            }
        }
    }
}


