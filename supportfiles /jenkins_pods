#########################Jenkins pod creation yml Raw yml##############################

apiVersion: v1
kind: Pod

spec:
  securityContext:
    fsGroup: 1000

  containers:

  - name: jnlp
    image: jenkins/inbound-agent:latest-jdk21
    imagePullPolicy: Always

    securityContext:
      runAsUser: 1000
      runAsGroup: 1000

    workingDir: /home/jenkins/agent

    tty: true

    volumeMounts:
    - name: workspace-volume
      mountPath: /home/jenkins/agent

  - name: maven
    image: maven:3.9.9-eclipse-temurin-21
    imagePullPolicy: Always

    command:
    - cat

    tty: true

    workingDir: /home/jenkins/agent

    volumeMounts:
    - name: workspace-volume
      mountPath: /home/jenkins/agent

  volumes:
  - name: workspace-volume
    emptyDir: {}

